# ─────────────────────────────────────────────────────────────
# Azoria — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────────

# Django Security
DJANGO_SECRET_KEY=your-super-secret-key-here-replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional, defaults to SQLite in development)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (optional, for production)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=hello@azoria.ci
# EMAIL_HOST_PASSWORD=your-email-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Azoria <noreply@azoria.ci>
